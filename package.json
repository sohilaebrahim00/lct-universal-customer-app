{
  "name": "lct-universal-customer-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@stripe/stripe-react-native": "0.64.0",
    "@supabase/supabase-js": "^2.112.3",
    "aes-js": "^3.1.2",
    "base64-arraybuffer": "^1.0.2",
    "date-fns": "^4.4.0",
    "expo": "^57.0.14",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.11",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.11",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.33.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.13.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "expo start --android --dev-client",
    "ios": "expo start --ios --dev-client",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src scripts",
    "test": "jest",
    "export:web": "expo export --platform web --clear && node scripts/verify-build-mode.mjs dist && node scripts/verify-maps-keys.mjs web",
    "export:ios": "node scripts/verify-maps-keys.mjs ios && expo export --platform ios --clear",
    "build:dev": "node scripts/verify-maps-keys.mjs ios,android && eas build --profile development",
    "verify:build-mode": "node scripts/verify-build-mode.mjs",
    "verify:maps-keys": "node scripts/verify-maps-keys.mjs",
    "verify:a11y": "node scripts/a11y-gate.mjs"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "src/lib/**/*.ts",
      "!src/**/*.d.ts"
    ]
  },
  "private": true
}
