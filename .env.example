# LCT Universal Customer App — environment configuration.
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# IMPORTANT: every EXPO_PUBLIC_* variable here is compiled directly into the
# JS bundle and shipped to every device that installs the app — it is
# readable by anyone. Only put client-safe values here (anon keys,
# publishable keys, a plain API URL). Never put a service-role key, a secret
# key, or anything from the backend's own .env in this file.

# --- Backend API -----------------------------------------------------------
# Points at the lct-universal-backend Express server (see that repo).
# For local dev with the backend running on your machine and the app in
# Expo Go on a physical device, "localhost" won't resolve — use your
# machine's LAN IP instead (e.g. http://192.168.1.20:4000).
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WS_URL=ws://localhost:4000

# --- Supabase Auth (anon/public key only — never the service-role key) -----
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe (publishable key only — never the secret key) ------------------
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Google Maps (client-side map rendering; separate from the native ------
# manifest keys below, which are read at build time by app.config.ts)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Build-time only (read by app.config.ts, baked into the native app, ----
# NOT exposed as EXPO_PUBLIC_* — restrict these by platform + bundle ID /
# package name + SHA-1 fingerprint in the Google Cloud Console)
GOOGLE_MAPS_API_KEY_IOS=
GOOGLE_MAPS_API_KEY_ANDROID=
STRIPE_MERCHANT_IDENTIFIER=merchant.com.lctuniversal.customer

# --- EAS (only needed once you run `eas build`) -----------------------------
EAS_PROJECT_ID=
